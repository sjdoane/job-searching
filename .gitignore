# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real keys live in .env.local (gitignored). The committed
# .env.example is a safe, key-less template.
.env*
!.env.example

# secrets, tokens, OAuth credentials — NEVER commit
*.token
*.token.json
tokens/
secrets/
credentials.json
client_secret*.json
google-credentials*.json

# local data / databases (DB lives outside OneDrive, but guard anyway)
*.db
*.db-*
*.sqlite
*.sqlite3
/data/
/local-data/

# user context files dropped into the repo root (resumes, project info)
# NOTE: this repo is PUBLIC — personal materials (resume, GPA, contact info,
# salary prefs) and all generated profile docs stay local and are never pushed.
/context/
/inbox/
/samcontext/

# local dev server log
dev-server.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
