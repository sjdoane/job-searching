# ===========================================================================
# Job Search Command Center — environment template
# ---------------------------------------------------------------------------
# Copy this file to ".env.local" and paste your keys there. .env.local is
# gitignored (this repo is PUBLIC) so your keys never get committed. Restart the
# dev server (`npm run dev`) after editing.
# ===========================================================================

# --- Anthropic API — optional AI résumé-tailoring pass ----------------------
# Get a key: https://console.anthropic.com  ->  Settings  ->  API keys  ->  Create
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google OAuth — Gmail (read-only) + Google Calendar sync ----------------
# One OAuth client covers BOTH Gmail and Calendar. One-time setup:
#   1. https://console.cloud.google.com  ->  create a project (any name).
#   2. "APIs & Services"  ->  Library  ->  enable BOTH:
#        - Gmail API
#        - Google Calendar API
#   3. "APIs & Services"  ->  OAuth consent screen:
#        - User type: External.  App name + your email.
#        - Scopes: add  .../auth/gmail.readonly  and  .../auth/calendar.events
#        - Test users: add your own Gmail address.
#        - Publishing status: set to "In production" (it stays UNVERIFIED, which
#          is fine for personal use). This avoids Google expiring your login
#          every 7 days. At sign-in you'll see an "unverified app" screen ->
#          click "Advanced" -> "Go to ... (unsafe)". It's your own app.
#   4. "APIs & Services"  ->  Credentials  ->  Create credentials  ->
#      "OAuth client ID":
#        - Application type: Web application
#        - Authorized redirect URI: paste exactly the GOOGLE_REDIRECT_URI below
#        - Copy the generated Client ID + Client secret into the two lines below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
